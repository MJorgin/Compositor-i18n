    "Zoom percentage (0.1–3200%). Press Return to apply.": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放百分比（0.1–3200%）。按 Return 应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮放百分比（0.1–3200%）。按下 Return 鍵以套用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズーム率（0.1～3200%）。Returnキーを押して適用してください。"
