          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有列印尺寸和解析度會改變。像素則保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更されるのは印刷サイズと解像度のみです。ピクセル数は変わりません。"
