    "Off leaves the picture as it is. Guided straightens from lines you draw on the picture.": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭则保持画面原样。引导则依据你在画面上画的线拉直。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「Off」會保持圖片原樣。「Guided」則會根據您在圖片上繪製的線條進行校正。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Off」は画像をそのままにします。「Guided」は、画像上に描いた線に沿って画像をまっすぐに整えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'Off'를 선택하면 그림이 그대로 유지됩니다. 'Guided'를 선택하면 그림에 그린 선을 따라 그림이 곧게 펴집니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción «Sin» deja la imagen tal y como está. La opción «Guiada» endereza la imagen a partir de las líneas que dibujes en ella."
          }
        }
      }
    },
