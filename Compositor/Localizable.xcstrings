    "Shapes fill with the foreground color; click to change it": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形状用前景色填充；点击可更改前景色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖形會以前景色填滿；點擊即可變更顏色"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図形は前景色で塗りつぶされます。クリックして色を変更してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도형은 전경색으로 채워집니다. 클릭하면 색상을 변경할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las formas se rellenan con el color de primer plano; haz clic para cambiarlo"
          }
        }
      }
    },
