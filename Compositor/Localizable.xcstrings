    "Strengthens or weakens every color by the same amount.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以相同程度增强或减弱每种颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將每種顏色以相同的幅度增強或減弱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての色を同じだけ濃くしたり薄くしたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 색상을 동일한 정도로 더 진하게 하거나 더 옅게 만듭니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta o disminuye la intensidad de todos los colores en la misma medida."
          }
        }
      }
    },
    "Strengthens or weakens the blue primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱蓝色原色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強或減弱藍色主色調。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "青のプライマリを強調または弱めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파란색 기본 색상을 더 강하게 또는 더 약하게 만듭니다."
          }
        },
        "es": {
