    "Liquify pushes pixels · Blur softens · Smudge drags color along": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "液化推动像素 · 模糊柔化 · 涂抹拖动颜色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「液化」會推擠像素 · 「模糊」會柔化 · 「塗抹」會拖曳顏色"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「リキファイ」はピクセルを押し広げ、「ぼかし」は輪郭を柔らかくし、「スミッジ」は色をなぞるように広げる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘액화’는 픽셀을 밀어내고, ‘흐림’은 부드럽게 만들고, ‘번짐’은 색을 끌고 다닙니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La herramienta «Liquify» deforma los píxeles · El desenfoque suaviza · La herramienta «Smudge» arrastra el color"
          }
        }
      }
    },
