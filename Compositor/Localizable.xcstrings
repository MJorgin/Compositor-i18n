    "Hide Others": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏其他"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏其他"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかを隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 항목 숨기기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar otros"
          }
        }
      }
    },
    "Hide the background behind a layer mask, keeping the foreground subjects. The pixels stay, so the background can be painted back at any time.": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用图层蒙版隐藏背景，保留前景主体。像素仍然保留，随时可以把背景画回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將背景隱藏在圖層遮色片後方，同時保留前景的主體。由於像素仍保留在圖層中，因此隨時都能將背景重新繪製回來。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーマスクを使って背景を隠し、前景の被写体だけを残します。ピクセルはそのまま残るので、いつでも背景を塗り直すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어 마스크를 사용하여 전경의 피사체만 남기고 배경을 숨깁니다. 픽셀은 그대로 유지되므로, 언제든지 배경을 다시 칠할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta el fondo detrás de una máscara de capa, conservando los sujetos en primer plano. Los píxeles se mantienen, por lo que el fondo se puede volver a pintar en cualquier momento."
          }
        }
      }
    },
