    "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel.": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三向显示阴影、中间调和高光。其他选项显示一个色轮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「三向」顯示陰影、中間調和高光。其餘選項則顯示一個色輪。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「3ウェイ」では、シャドウ、ミッドトーン、ハイライトが表示されます。その他の選択肢では、1つのホイールが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'3-Way'는 그림자, 중간 톤, 하이라이트를 보여줍니다. 다른 옵션들은 하나의 휠만 표시합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción «Three-Way» muestra sombras, tonos medios y luces. Las demás opciones muestran una sola rueda."
          }
        }
      }
    },
