    "Crops empty edges after the transform and fits the result back into the frame.": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变换后裁掉空白边缘，并将结果缩回画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在變換後裁切掉多餘的邊緣，並將結果重新調整以適應畫面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変形後に余白をトリミングし、その結果をフレーム内に収めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환 후 빈 가장자리를 잘라내고, 그 결과를 다시 프레임에 맞춥니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorta los bordes vacíos tras la transformación y vuelve a ajustar el resultado al encuadre."
          }
        }
      }
    },
