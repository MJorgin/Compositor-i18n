    "Use 1–%@ pixels per side, up to %lld megapixels, and 1–9,600 pixels/inch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use 1–%1$@ pixels per side, up to %2$lld megapixels, and 1–9,600 pixels/inch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边使用 1–%@ 像素，最多 %lld 百万像素，以及 1–9,600 像素/英寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每邊使用 1–%1$@ 像素，最高可達 %2$lld 百萬像素，且每英吋 1–9,600 像素。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1～%1$@ピクセル/辺、最大%2$lldメガピクセル、および1～9,600ピクセル/インチを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 변당 1–%1$@ 픽셀, 최대 %2$lld 메가픽셀, 1–9,600 픽셀/인치를 사용하십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza entre 1 y %1$@ píxeles por lado, hasta un máximo de %2$lld megapíxeles, y entre 1 y 9.600 píxeles por pulgada."
          }
        }
      }
    },
    "Use gridlines every %lld–%@ pixels and %lld–%lld subdivisions, no more than the pixels between gridlines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use gridlines every %1$lld–%2$@ pixels and %3$lld–%4$lld subdivisions, no more than the pixels between gridlines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格线间隔 %lld–%@ 像素，细分网格 %lld–%lld，且不得超过网格线之间的像素数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每 %1$lld–%2$@ 像素使用一次網格線，並設有 %3$lld–%4$lld 個子網格，其間距不得超過相鄰兩條網格線之間的像素數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld～%2$@ピクセルごとにグリッド線を表示し、%3$lld～%4$lldの細分化を行う。ただし、グリッド線間のピクセル数を超えないようにする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld–%2$@ 픽셀 간격으로 격자선을 표시하고, %3$lld–%4$lld 개의 세분 단위를 적용하되, 각 세분 단위 간의 거리는 격자선 간격보다 길지 않아야 합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza líneas de cuadrícula cada %1$lld–%2$@ píxeles y %3$lld–%4$lld subdivisiones, sin que el número de subdivisiones supere el número de píxeles entre líneas de cuadrícula."
          }
        }
      }
    },
