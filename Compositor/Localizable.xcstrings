    "Clear the haze that leaves background showing through thin areas": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除薄雾，避免背景透过稀薄区域显现"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "消除因薄處導致背景透出的朦朧感"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薄い部分から背景が透けて見えるぼやけを取り除く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얇은 부분으로 인해 배경이 비치는 현상을 제거하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la neblina que hace que se vea el fondo a través de las zonas más transparentes"
          }
        }
      }
    },
    "Clears haze when raised, and adds haze when lowered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提高时清除薄雾，降低时添加薄雾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "升起時消除霧氣，降下時增添霧氣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上げると霞が消え、下げると霞が加わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올리면 안개가 걷히고, 내리면 안개가 짙어집니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
