      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基本模式快速；高级模式依据图层自身细节细化蒙版，适合头发和毛发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「基本」模式處理迅速；「進階」模式則會根據圖層本身的細節來精細調整遮色片，適用於頭髮和毛髮"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「基本」は処理が速い。「詳細」は、レイヤー自体のディテールに合わせてマスクを微調整し、髪の毛や毛並みを表現します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'기본' 모드는 처리 속도가 빠르며, '고급' 모드는 레이어 자체의 디테일을 바탕으로 마스크를 정교하게 다듬어 머리카락이나 털을 표현합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción «Básica» es rápida; la opción «Avanzada» perfecciona la máscara en función de los detalles de la propia capa, para el pelo y el pelaje."
          }
        }
      }
    },
