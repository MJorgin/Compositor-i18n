        }
      }
    },
    "Drag an ellipse · Shift add · Option subtract · Shift again mid-drag circle · Drag inside to move · Delete clears · ⌘D deselect": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动椭圆 · Shift 添加 · Option 减去 · 拖动中再按 Shift 画正圆 · 内部拖动可移动 · Delete 清除 · ⌘D 取消选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳橢圓 · 按住 Shift 鍵可新增 · 按住 Option 鍵可刪除 · 拖曳途中再次按住 Shift 鍵可畫圓 · 拖曳內部可移動 · 按 Delete 鍵清除 · 按 ⌘D 取消選取"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "楕円をドラッグ · Shiftキーを押しながら追加 · Optionキーを押しながら削除 · ドラッグ中に再度Shiftキーを押すと円になる · 内側をドラッグして移動 · Deleteキーで消去 · ⌘Dで選択解除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타원을 드래그 · Shift 키를 누른 채 추가 · Option 키를 누른 채 빼기 · 드래그 도중 Shift 키를 다시 누르면 원으로 변환 · 안쪽을 드래그하여 이동 · Delete 키로 지우기 · ⌘D로 선택 해제"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para dibujar una elipse · Mantén pulsada la tecla Mayús para sumar · Mantén pulsada la tecla Opción para restar · Vuelve a pulsar Mayús mientras arrastras para dibujar un círculo · Arrastra por dentro para moverlo · La tecla Supr borra · ⌘D deselecciona"
          }
        }
      }
    },
    "Drag inside the wheel. Angle sets hue, distance sets saturation.": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在色轮内拖动。角度设定色相，距离设定饱和度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在圓圈內拖曳。角度決定色相，距離決定飽和度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホイール内をドラッグしてください。角度で色相を、距離で彩度を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바퀴 안쪽으로 드래그하세요. 각도를 조절하면 색조를, 거리를 조절하면 채도를 설정할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el cursor dentro de la rueda. El ángulo determina el tono y la distancia, la saturación."
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines.": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图层上拖放参考线。至少画两条线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳圖層以放置輔助線。請繪製至少兩條線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーをドラッグしてガイドを配置します。少なくとも2本の線を描いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어를 드래그하여 가이드를 배치하세요. 선을 두 개 이상 그려주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el cursor sobre la capa para colocar una guía. Dibuja al menos dos líneas."
          }
        }
      }
    },
    "Drag on the picture to move the curve for the tone under the pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画面上拖动，移动指针所在色调对应的曲线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳圖片以移動游標下方色調的曲線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像をドラッグすると、ポインタの下にあるトーンの曲線が移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림을 드래그하면 포인터 아래에 있는 톤의 곡선이 이동합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la imagen para mover la curva del tono situado debajo del puntero."
          }
        }
      }
    },
    "Drag or scroll to move around; double-click switches between Fit and 100%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动或滚动移动视图；连按可在适合窗口与 100% 间切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳或捲動以移動畫面；雙擊可在「適應畫面」與「100%」之間切換"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグまたはスクロールして移動します。ダブルクリックすると、「画面に合わせる」と「100%」が切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하거나 스크롤하여 화면을 이동할 수 있으며, 더블 클릭하면 ‘화면 맞추기’와 ‘100%’ 모드 간에 전환됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra o desplázate para moverte por la pantalla; al hacer doble clic, se alterna entre «Ajustar» y «100 %»."
          }
        }
      }
    },
    "Drag over blemishes to heal · [ ] size · Shift-[ ] hardness · Escape cancel · Space to pan": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在瑕疵上拖移修复 · [ ] 大小 · Shift-[ ] 硬度 · Esc 取消 · 空格 平移"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳至瑕疵處以修復 · [ ] 調整大小 · Shift-[ ] 調整硬度 · Esc 取消 · 空格鍵平移"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミの上にドラッグして修復 · [ ] サイズ · Shift+[ ] 硬さ · Esc キーでキャンセル · スペースキーでパン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결점 부위를 드래그하여 치료 · [ ] 크기 · Shift-[ ] 경도 · Esc 키로 취소 · 스페이스 바로 이동"
          }
        },
        "es": {
