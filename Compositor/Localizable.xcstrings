    "Highlight Priority": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光优先"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高光優先"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライト優先"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
