    "Your changes will be lost if you don’t save them.": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不存储，更改将丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若未儲存，您的變更將會遺失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更内容を保存しないと、その変更は失われてしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 내용을 저장하지 않으면 내용이 사라집니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no guardas los cambios, se perderán."
          }
        }
      }
