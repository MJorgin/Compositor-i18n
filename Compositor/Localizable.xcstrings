    "Blend the chosen color into the edges while keeping the center unchanged": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选颜色融入边缘，同时保持中心不变"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將選定的顏色漸層暈染至邊緣，同時保持中央部分不變"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央の部分はそのままに、選択した色を縁の部分にぼかしてなじませる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중앙 부분은 그대로 유지한 채, 선택한 색상을 가장자리 부분과 자연스럽게 어우러지게 하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Difumina el color elegido hacia los bordes sin modificar el centro"
          }
        }
      }
    },
