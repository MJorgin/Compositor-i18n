            "value": "Conservar luminosidad"
          }
        }
      }
    },
    "Preserves colored edges while color noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少彩色杂色时保留彩色边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在降低色彩雜訊的同時，保留色彩邊緣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色のノイズを低減しつつ、色の縁を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상 노이즈는 줄이면서도 색상 경계를 유지합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los bordes de color al tiempo que se reduce el ruido de color."
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少明度杂色时保留细腻纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在降低亮度雜訊的同時，仍能保留細膩的質感。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きめ細かな質感を保ちつつ、輝度ノイズを低減します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화질의 섬세한 질감을 유지하면서 휘도 노이즈를 줄여줍니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la textura fina al tiempo que se reduce el ruido de luminancia."
          }
        }
      }
    },
