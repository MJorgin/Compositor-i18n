        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在預覽畫面中畫出兩條或更多條應保持水平或垂直的線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー上に、水平または垂直になるように2本以上の線を引いてください。"
