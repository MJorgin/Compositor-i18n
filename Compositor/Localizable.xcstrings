          "stringUnit": {
            "state": "translated",
            "value": "縮小遮罩以去除主體周圍的背景色邊框，或擴大遮罩"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスクを縮小して被写体の周囲にある背景色の縁をなくすか、あるいはマスクを拡大します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스크를 축소하여 피사체 주변의 배경색 테두리를 없애거나, 마스크를 확대하세요."
          }
        },
        "es": {
