    "Smooth selection edges; turn off for hard pixel edges": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑选区边缘；关闭则保持生硬的像素边缘"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑選取邊緣；若需呈現硬邊緣，請關閉此功能"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲の縁を滑らかにする。ピクセルの縁をハッキリさせたい場合はオフにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 영역의 가장자리를 부드럽게 처리합니다. 픽셀 가장자리를 선명하게 하려면 이 기능을 끕니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suavizar los bordes de la selección; desactivar esta opción para obtener bordes de píxeles definidos"
          }
        }
      }
    },
    "Smooth the detected object outline; turn off for the raw pixel mask": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑检测到的对象轮廓；关闭则使用原始像素蒙版"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑偵測到的物件輪廓；若要使用原始像素遮罩，請關閉此功能"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出されたオブジェクトの輪郭を滑らかにします。生のピクセルマスクを使用する場合は、この機能をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지된 객체의 윤곽을 부드럽게 다듬습니다. 원시 픽셀 마스크를 사용하려면 이 기능을 끕니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suaviza el contorno del objeto detectado; desactívalo para obtener la máscara de píxeles sin procesar"
          }
        }
      }
    },
