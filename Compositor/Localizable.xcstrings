          "stringUnit": {
            "state": "translated",
            "value": "赤のプライマリを強調または弱めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빨간색 기본색을 더 강하게 또는 더 약하게 만듭니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta o disminuye la intensidad del rojo primario."
          }
        }
      }
    },
    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对较弱颜色的增强多于已强的颜色，并保护肤色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相較於原本就鮮豔的顏色，更能突顯低調色調，並能保護膚色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに鮮やかな色よりも、落ち着いた色をより引き立て、肌のトーンを保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 선명한 색상보다 차분한 색상을 더욱 돋보이게 하며, 피부 톤을 보호해 줍니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realza los colores suaves más que los colores que ya son intensos, y protege los tonos de piel."
          }
        }
      }
    },
    "Stretches width relative to height.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对于高度拉伸宽度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依高度拉伸寬度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高さに対して幅を伸ばします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높이에 비해 너비를 늘립니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira la anchura en relación con la altura."
          }
        }
      }
    },
