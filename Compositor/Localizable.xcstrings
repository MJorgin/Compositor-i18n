    "Weakens green fringes inside the green hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在绿色色相范围内减弱绿色边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減弱綠色色調範圍內的綠色邊緣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑の色相範囲内の緑色のフリンジを弱めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹색 색조 범위 내의 녹색 테두리를 약화시킵니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenúa los tonos verdes más claros dentro de la gama de tonos verdes."
          }
        }
      }
    },
    "Weakens purple fringes inside the purple hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在紫色色相范围内减弱紫色边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減弱紫色色調範圍內的紫色邊緣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紫色の色相範囲内の紫色のフリンジを弱めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보라색 색조 범위 내의 보라색 테두리를 약화시킵니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenúa los matices púrpura dentro de la gama de tonos púrpura."
          }
        }
      }
    },
