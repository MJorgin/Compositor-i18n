    "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每个粗像素画成实心方块，或像点阵屏那样画成圆点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將每個粗獷像素繪製為實心正方形，或像點陣螢幕那樣繪製為圓點"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各チャンキーピクセルを、塗りつぶされた正方形として、あるいはドットマトリクスディスプレイのような丸いドットとして描画します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 굵은 픽셀을 채워진 사각형으로 그리거나, 도트 매트릭스 화면처럼 둥근 점으로 그립니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja cada píxel grueso como un cuadrado relleno o como un punto redondo, como en una pantalla de matriz de puntos."
          }
        }
      }
    },
    "Draw the marks for the light tones on the dark color, like a glowing screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色上画出亮调的标记，像发光的屏幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色背景上畫出淺色的標記，就像發光的螢幕一樣"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗い色の上に、まるで光る画面のように、明るい色のマークを描いてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 색 위에 밝은 톤의 선을, 마치 빛나는 화면처럼 그려주세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja las marcas de los tonos claros sobre el color oscuro, como si fuera una pantalla luminosa."
          }
        }
      }
    },
    "Draw two or more lines on the preview that should be level or vertical.": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
