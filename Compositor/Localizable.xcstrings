    "Magic (W) · Tab switches Wand and Object": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "魔棒 (W) · Tab 切换魔棒/对象"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "魔法 (W) · 按 Tab 鍵可在魔杖與物品之間切換"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "魔法（W） · タブキーで「杖」と「アイテム」を切り替えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마법 (W) · 탭 키로 지팡이와 물체를 전환합니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Magia (W) · La tecla Tab alterna entre «Varita» y «Objeto»"
          }
        }
      }
    },
    "Make each dithered pixel this many pixels across, for a chunky old-screen look": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让每个抖动像素横跨这么多像素，做出粗颗粒老屏幕效果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將每個抖動像素的寬度設定為這個數值，以呈現舊式螢幕那種粗獷的外觀"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディザ処理された各ピクセルの幅をこのピクセル数にすることで、昔ながらの画面のようなゴツゴツした質感を出します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디더링된 각 픽셀의 가로 크기를 이만큼으로 설정하여, 투박하고 옛날 화면 같은 느낌을 연출하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece el ancho de cada píxel difuminado en este número de píxeles, para conseguir un aspecto grueso, como el de las pantallas antiguas"
          }
        }
      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让亮暗色调的差别变大或变小，主要集中在中间调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使明暗色調的差異程度有所增減，主要集中在中段範圍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るい色調と暗い色調の差を、主に中間色を中心に、多少強めたり弱めたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝은 톤과 어두운 톤의 차이를 다소 더 크게 또는 작게 만들어 주며, 주로 중간 톤 부근에서 그런 효과가 나타납니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que los tonos claros y oscuros se distingan más o menos, sobre todo en la zona central."
          }
        }
      }
    },
    "Makes the color smoothing softer or tighter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让颜色平滑更柔和或更紧致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使色彩平滑效果更柔和或更緊緻。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色の平滑化を柔らかくしたり、きつくしたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상 보정 효과를 더 부드럽게 또는 더 선명하게 만듭니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el suavizado del color sea más suave o más marcado."
          }
        }
      }
    },
    "Makes the grain coarser or finer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让颗粒更粗或更细。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制顆粒粗細。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "粒子を粗くまたは細かくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그레인을 거칠거나 미세하게 만듭니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el grano sea más grueso o más fino."
          }
        }
      }
    },
    "Makes the grain smoother or more uneven.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让颗粒更平滑或更不均。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使紋理更平滑或更不均勻。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "木目を滑らかにしたり、より不均一にしたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입자를 더 매끄럽게 하거나 더 고르지 않게 만듭니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que la textura sea más suave o más irregular."
          }
        }
      }
    },
    "Makes the picked color lighter or darker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所选颜色变浅或变深。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將選取的顏色調亮或調暗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色を明るくしたり、暗くしたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 색상을 더 밝게 또는 더 어둡게 만듭니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aclara u oscurece el color seleccionado."
          }
        }
      }
    },
    "Makes the picked color stronger or quieter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所选颜色变强或变弱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使選定的顏色更鮮豔或更柔和。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色の彩度を高くしたり、低くしたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 색상을 더 진하게 또는 더 은은하게 만듭니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el color seleccionado sea más intenso o más suave."
          }
        }
      }
    },
    "Makes the vignette rounder or more square.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让晕影更圆或更方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使暗角效果更圓潤或更方正。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビネットを丸みを帯びた形にしたり、角ばった形にしたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비네트를 더 둥글게 또는 더 각지게 만듭니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que la viñeta sea más redondeada o más cuadrada."
          }
        }
      }
    },
    "Manual": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
