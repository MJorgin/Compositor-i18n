    "Straightens barrel or pincushion bending.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉直桶形或枕形弯曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "矯正槍管或針墊狀彎曲。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バレル状やピンクッション状の歪みを矯正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배럴형 또는 핀쿠션형 뒤틀림을 바로잡습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereza las deformaciones en forma de barril o de alfiletero."
          }
        }
      }
    },
    "Straightens horizontal lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将水平线向中心拉直。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將水平線向中心方向拉直。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水平線を中央に向かってまっすぐに整えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수평선을 중앙을 향해 곧게 펴줍니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinea las líneas horizontales hacia el centro."
          }
        }
      }
    },
    "Straightens vertical lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将垂直线向中心拉直。"
