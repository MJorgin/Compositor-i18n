    "Adds film grain, strongest in the middle tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，中间调最明显。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增添膠片顆粒感，在中調處最為明顯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルムの粒状感を加え、中間調で最も強く現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필름 그레인을 추가하며, 중간 톤에서 가장 강하게 나타납니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade grano de película, más marcado en los tonos medios."
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为最暗的色调加入绿色或洋红。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最深的色調中加入綠色或洋紅色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も暗いトーンに緑またはマゼンタを加えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 어두운 톤에 녹색이나 마젠타를 더합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade verde o magenta a los tonos más oscuros."
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或柔化较大形体上的对比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在較寬的形狀上增加或柔化對比度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広い形状に沿ってコントラストを追加したり、和らげたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넓은 형태의 윤곽을 따라 대비를 더하거나 부드럽게 만듭니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade o suaviza el contraste en las formas más amplias."
          }
        }
      }
    },
    "Adds or softens small detail.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或柔化细小细节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增添或柔化細微的細節。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "細かいディテールを追加したり、柔らかく表現したりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 디테일을 더하거나 부드럽게 다듬습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade o suaviza pequeños detalles."
          }
        }
      }
    },
    "Adjusts the bright parts of the picture. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整画面的亮部。按住 Option 可查看被裁切的高光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整畫面中的亮部。按住 Option 鍵可查看過曝的高光部分。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の明るい部分を調整します。Option キーを押したままにすると、クリップされたハイライト部分が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진의 밝은 부분을 조정합니다. Option 키를 누르고 있으면 클리핑된 하이라이트를 확인할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta las zonas más claras de la imagen. Mantén pulsada la tecla Opción para ver las luces recortadas."
          }
        }
      }
    },
    "Adjusts the dark parts of the picture. Hold Option to see clipped shadows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整画面的暗部。按住 Option 可查看被裁切的阴影。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整圖片中的暗部。按住 Option 鍵可查看被裁切的陰影。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の暗い部分を調整します。Option キーを押したままにすると、クリップされたシャドウ部分を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진의 어두운 부분을 조정합니다. Option 키를 누르고 있으면 클리핑된 그림자 부분을 확인할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
