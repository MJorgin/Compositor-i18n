    },
    "Adds green or magenta to the darkest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为最暗的色调加入绿色或洋红。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或柔化较大形体上的对比。"
