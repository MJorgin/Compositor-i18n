    "Zoom in (⌘+), now %@. At 100%% each pixel of the JPEG is one pixel of the screen, as on the canvas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大（⌘+），当前 %@。在 100%% 时，JPEG 的每个像素对应屏幕的一个像素，与画布上相同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大 (⌘+)，現在是 %@。在 100%% 時，JPEG 中的每個像素等同於螢幕上的一個像素，就像在畫布上一樣"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームイン（⌘+）して、%@にします。100%%では、JPEGの各ピクセルが画面上の1ピクセルとなり、キャンバス上と同じになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대하기 (⌘+), 이제 %@입니다. 100%%에서는 캔버스에서와 마찬가지로 JPEG의 각 픽셀이 화면의 한 픽셀에 해당합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca la imagen (⌘+), ahora %@. Al 100 %%, cada píxel del JPEG equivale a un píxel de la pantalla, igual que en el lienzo."
          }
        }
      }
    },
