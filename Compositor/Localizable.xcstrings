            "value": "仅从当前图层读取颜色，或如图所示从所有可见图层读取"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅從當前選取的圖層讀取顏色，或如圖所示從所有可見圖層讀取顏色"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
