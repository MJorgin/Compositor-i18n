    "A blank space for your next composition.": {
      "extractionState": "legacy",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你的下一幅作品留一块空白。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一片空白，供您創作下一幅作品。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの次の作品のための空白のスペース。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 작품을 위한 빈 공간."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio en blanco para tu próxima composición."
          }
        }
      }
    },
    "A subdivision every %@ pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔 %@ 像素一条细分网格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每 %@ 像素進行一次細分。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ピクセルごとに細分化されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 픽셀마다 한 칸씩 나뉩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una subdivisión cada %@ píxeles."
          }
        }
      }
    },
